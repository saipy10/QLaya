{
  "name": "qlaya",
  "version": "0.4.1",
  "description": "QLaya: fast, local, on-device decision engine with user-selectable quantized model variants (TypeScript runtime)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:package": "node --test tests/package-e2e.mjs",
    "prepack": "npm run build"
  },
  "files": ["dist", "scripts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saipy10/QLaya.git",
    "directory": "qlaya-ts"
  },
  "keywords": [
    "decision-model",
    "system-one",
    "routing",
    "guardrails",
    "moderation",
    "triage",
    "onnx",
    "quantization",
    "qlaya"
  ],
  "author": "saipy10",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/saipy10/QLaya/issues"
  },
  "homepage": "https://github.com/saipy10/QLaya#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": { "onnxruntime-node": "^1.20.0", "onnxruntime-web": "^1.20.0" }
}
